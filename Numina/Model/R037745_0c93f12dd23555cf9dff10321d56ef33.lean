import Mathlib

theorem algebra_19082 : (12 : ℝ) ^ ((1 : ℝ) / 3) * (20) ^ ((1 : ℝ) / 3) *
    (15) ^ ((1 : ℝ) / 3) * (60) ^ ((1 : ℝ) / 3) = 60 := by
  have h1 : (12 : ℝ) ^ ((1 : ℝ) / 3) * (20) ^ ((1 : ℝ) / 3) =
          ((12 : ℝ) * (20 : ℝ)) ^ ((1 : ℝ) / 3) := by
    rw [← Real.mul_rpow]
    all_goals norm_num
  have h2 : (12 : ℝ) ^ ((1 : ℝ) / 3) * (20) ^ ((1 : ℝ) / 3) * (15 : ℝ) ^ ((1 : ℝ) / 3) =
          ((12 : ℝ) * (20 : ℝ) * (15 : ℝ)) ^ ((1 : ℝ) / 3) := by
    have h3 : (12 : ℝ) ^ ((1 : ℝ) / 3) * (20 : ℝ) ^ ((1 : ℝ) / 3) =
          ((12 : ℝ) * (20 : ℝ)) ^ ((1 : ℝ) / 3) := h1
    rw [h3]
    rw [← Real.mul_rpow]
    all_goals norm_num
  have h4 : (12 : ℝ) ^ ((1 : ℝ) / 3) * (20) ^ ((1 : ℝ) / 3) * (15 : ℝ) ^ ((1 : ℝ) / 3) * (60 : ℝ) ^ ((1 : ℝ) / 3) =
          ((12 : ℝ) * (20 : ℝ) * (15 : ℝ) * (60 : ℝ)) ^ ((1 : ℝ) / 3) := by
    have h5 : (12 : ℝ) ^ ((1 : ℝ) / 3) * (20) ^ ((1 : ℝ) / 3) * (15 : ℝ) ^ ((1 : ℝ) / 3) =
          ((12 : ℝ) * (20 : ℝ) * (15 : ℝ)) ^ ((1 : ℝ) / 3) := h2
    rw [h5]
    rw [← Real.mul_rpow]
    all_goals norm_num
  rw [h4]
  have h5 : (12 : ℝ) * (20 : ℝ) * (15 : ℝ) * (60 : ℝ) = (60 : ℝ) ^ 3 := by norm_num
  rw [h5]
  have h6 : ((60 : ℝ) ^ 3) ^ ((1 : ℝ) / 3) = (60 : ℝ) := by
    have h10 : ((60 : ℝ) ^ 3) ^ ((1 : ℝ) / 3) = (60 : ℝ) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul]
      norm_num
      all_goals norm_num
    exact h10
  linarith [h6]