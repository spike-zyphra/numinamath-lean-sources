import Mathlib

theorem algebra_283651 : (375 : ℝ) ^ ((1 : ℝ) / 5) * (600) ^ ((1 : ℝ) / 6) * (45) ^ ((1 : ℝ) / 15) = 5 * Real.sqrt 6 := by

  have h1 : (375 : ℝ) ^ ((1 : ℝ) / 5) = (3 : ℝ) ^ ((1 : ℝ) / 5) * (5 : ℝ) ^ ((3 : ℝ) / 5) := by
    have h2 : (375 : ℝ) = (3 * (5 ^ 3 : ℝ)) := by norm_num
    rw [h2]
    have h3 : ((3 * (5 ^ 3 : ℝ)) : ℝ) ^ ((1 : ℝ) / 5) = (3 : ℝ) ^ ((1 : ℝ) / 5) * ((5 ^ 3 : ℝ) ) ^ ((1 : ℝ) / 5) := by
      rw [← Real.mul_rpow]
      all_goals norm_num
    have h4 : ((5 ^ 3 : ℝ) ) ^ ((1 : ℝ) / 5) = (5 : ℝ) ^ ((3 : ℝ) / 5) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul]
      ring
      all_goals norm_num
    rw [h3, h4]

  have h2 : (600 : ℝ) ^ ((1 : ℝ) / 6) = (2 : ℝ) ^ ((1 : ℝ) / 2) * (3 : ℝ) ^ ((1 : ℝ) / 6) * (5 : ℝ) ^ ((1 : ℝ) / 3) := by
    have h3 : (600 : ℝ) = (2 ^ 3 * 3 * (5 ^ 2 : ℝ)) := by norm_num
    rw [h3]
    have h4 : ((2 ^ 3 * 3 * (5 ^ 2 : ℝ)) : ℝ) ^ ((1 : ℝ) / 6) =
            ((2 ^ 3 : ℝ) * (3 : ℝ) * (5 ^ 2 : ℝ)) ^ ((1 : ℝ) / 6) := by ring_nf
    rw [h4]
    have h5 : ((2 ^ 3 : ℝ) * (3 : ℝ) * (5 ^ 2 : ℝ)) ^ ((1 : ℝ) / 6) =
            ((2 ^ 3 : ℝ) ) ^ ((1 : ℝ) / 6) * ((3 : ℝ) ) ^ ((1 : ℝ) / 6) * ((5 ^ 2 : ℝ) ) ^ ((1 : ℝ) / 6) := by
      rw [← Real.mul_rpow, ← Real.mul_rpow]
      all_goals norm_num
    have h6 : ((2 ^ 3 : ℝ) ) ^ ((1 : ℝ) / 6) = (2 : ℝ) ^ ((1 : ℝ) / 2) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul]
      ring
      all_goals norm_num
    have h7 : ((5 ^ 2 : ℝ) ) ^ ((1 : ℝ) / 6) = (5 : ℝ) ^ ((1 : ℝ) / 3) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul]
      ring
      all_goals norm_num
    rw [h5, h6, h7]

  have h3 : (45 : ℝ) ^ ((1 : ℝ) / 15) = (3 : ℝ) ^ ((2 : ℝ) / 15) * (5 : ℝ) ^ ((1 : ℝ) / 15) := by
    have h4 : (45 : ℝ) = (3 ^ 2 * (5 : ℝ)) := by norm_num
    rw [h4]
    have h5 : ((3 ^ 2 * (5 : ℝ)) : ℝ) ^ ((1 : ℝ) / 15) = ((3 ^ 2 : ℝ) ) ^ ((1 : ℝ) / 15) * ((5 : ℝ) ) ^ ((1 : ℝ) / 15) := by
      rw [← Real.mul_rpow]
      all_goals norm_num
    have h6 : ((3 ^ 2 : ℝ) ) ^ ((1 : ℝ) / 15) = (3 : ℝ) ^ ((2 : ℝ) / 15) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul]
      ring
      all_goals norm_num
    rw [h5, h6]

  rw [h1, h2, h3]

  have h4 : (3 : ℝ) ^ ((1 : ℝ) / 5) * (5 : ℝ) ^ ((3 : ℝ) / 5) * ((2 : ℝ) ^ ((1 : ℝ) / 2) * (3 : ℝ) ^ ((1 : ℝ) / 6) * (5 : ℝ) ^ ((1 : ℝ) / 3) ) * ((3 : ℝ) ^ ((2 : ℝ) / 15) * (5 : ℝ) ^ ((1 : ℝ) / 15) ) =
    (2 : ℝ) ^ ((1 : ℝ) / 2) * ((3 : ℝ) ^ ((1 : ℝ) / 5) * (3 : ℝ) ^ ((1 : ℝ) / 6) * (3 : ℝ) ^ ((2 : ℝ) / 15) ) * ((5 : ℝ) ^ ((3 : ℝ) / 5) * (5 : ℝ) ^ ((1 : ℝ) / 3) * (5 : ℝ) ^ ((1 : ℝ) / 15) ) := by ring

  rw [h4]

  have h5 : (2 : ℝ) ^ ((1 : ℝ) / 2) * ((3 : ℝ) ^ ((1 : ℝ) / 5) * (3 : ℝ) ^ ((1 : ℝ) / 6) * (3 : ℝ) ^ ((2 : ℝ) / 15) ) * ((5 : ℝ) ^ ((3 : ℝ) / 5) * (5 : ℝ) ^ ((1 : ℝ) / 3) * (5 : ℝ) ^ ((1 : ℝ) / 15) ) = (2 : ℝ) ^ ((1 : ℝ) / 2) * (3 : ℝ) ^ ((1 / 2 : ℝ)) * (5 : ℝ) ^ (1 : ℝ) := by
    have h6 : (3 : ℝ) ^ ((1 : ℝ) / 5) * (3 : ℝ) ^ ((1 : ℝ) / 6) * (3 : ℝ) ^ ((2 : ℝ) / 15) = (3 : ℝ) ^ ((1 / 2 : ℝ)) := by
      have h7 : (3 : ℝ) ^ ((1 : ℝ) / 5) * (3 : ℝ) ^ ((1 : ℝ) / 6) * (3 : ℝ) ^ ((2 : ℝ) / 15) = (3 : ℝ) ^ ((1 : ℝ) / 5 + (1 : ℝ) / 6 + (2 : ℝ) / 15) := by
        rw [← Real.rpow_add, ← Real.rpow_add]
        all_goals norm_num
      have h8 : (1 : ℝ) / 5 + (1 : ℝ) / 6 + (2 : ℝ) / 15 = (1 / 2 : ℝ) := by
        norm_num
      rw [h8] at h7
      linarith

    have h7 : (5 : ℝ) ^ ((3 : ℝ) / 5) * (5 : ℝ) ^ ((1 : ℝ) / 3) * (5 : ℝ) ^ ((1 : ℝ) / 15) = (5 : ℝ) ^ (1 : ℝ) := by
      have h8 : (5 : ℝ) ^ ((3 : ℝ) / 5) * (5 : ℝ) ^ ((1 : ℝ) / 3) * (5 : ℝ) ^ ((1 : ℝ) / 15) = (5 : ℝ) ^ ((3 : ℝ) / 5 + (1 : ℝ) / 3 + (1 : ℝ) / 15) := by
        rw [← Real.rpow_add, ← Real.rpow_add]
        all_goals norm_num
      have h9 : (3 : ℝ) / 5 + (1 : ℝ) / 3 + (1 : ℝ) / 15 = (1 : ℝ) := by
        norm_num
      rw [h9] at h8
      linarith
    rw [h6, h7]

  rw [h5]

  have h6 : (2 : ℝ) ^ ((1 : ℝ) / 2) * (3 : ℝ) ^ ((1 / 2 : ℝ)) = Real.sqrt 6 := by
    have h7 : (2 : ℝ) ^ ((1 : ℝ) / 2) * (3 : ℝ) ^ ((1 / 2 : ℝ)) = ((6 : ℝ) ) ^ ((1 : ℝ) / 2) := by
      have h8 : (6 : ℝ) ^ ((1 : ℝ) / 2) = ((2 * 3 : ℝ) ) ^ ((1 : ℝ) / 2) := by
        norm_num
      have h9 : ((2 * 3 : ℝ) ) ^ ((1 : ℝ) / 2) = (2 : ℝ) ^ ((1 : ℝ) / 2) * (3 : ℝ) ^ ((1 : ℝ) / 2) := by
        rw [← Real.mul_rpow]
        all_goals norm_num
      rw [h8, h9]
    have h8 : ((6 : ℝ) ) ^ ((1 : ℝ) / 2) = Real.sqrt 6 := by
      have h9 : Real.sqrt 6 = (6 : ℝ) ^ (1 / 2 : ℝ) := by
        rw [Real.sqrt_eq_rpow]
      rw [h9]
    rw [h7, h8]

  have h7 : Real.sqrt 6 * (5 : ℝ) = 5 * Real.sqrt 6 := by
    ring

  rw [h6]
  linarith [h7]