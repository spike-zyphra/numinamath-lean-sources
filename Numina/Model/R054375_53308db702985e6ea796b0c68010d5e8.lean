import Mathlib

theorem algebra_3037 {A B : ℝ}
    (hA : A = ((2019 / 2020) + (2020 / 2021) + (2021 / 2022)) * (1 + (2020 / 2021) + (2021 / 2022)))
    (hB : B = (1 + (2019 / 2020) + (2020 / 2021) + (2021 / 2022)) * ((2020 / 2021) + (2021 / 2022))) : A - B = 2019 / 2020 := by 
  rw [hA, hB]
  norm_num