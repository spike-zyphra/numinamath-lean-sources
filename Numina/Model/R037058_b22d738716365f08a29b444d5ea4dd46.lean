import Mathlib

theorem inequalities_124962 : (99^2019 + 1 : ℝ) / (99^2020 + 1) > (99^2020 + 1) / (99^2021 + 1) := by
  have h1 : (99^2019 + 1 : ℝ) / (99^2020 + 1) - (99^2020 + 1) / (99^2021 + 1) > 0 := by
    have h3 : (99^2020 + 1 : ℝ) > 0 := by
      positivity
    have h4 : (99^2021 + 1 : ℝ) > 0 := by
      positivity
    have h5 : ((99^2019 + 1) : ℝ) * ((99^2021 + 1) : ℝ) > ((99^2020 + 1) : ℝ) * ((99^2020 + 1) : ℝ) := by
      norm_num
    have h7 : ((99^2019 + 1) : ℝ) / (99^2020 + 1) - (99^2020 + 1) / (99^2021 + 1) =
        ( ((99^2019 + 1) : ℝ) * ((99^2021 + 1) : ℝ) - ((99^2020 + 1) : ℝ) * ((99^2020 + 1) : ℝ) ) / ( ((99^2020 + 1) : ℝ) * ((99^2021 + 1) : ℝ) ) := by
      field_simp
      <;> ring
    rw [h7]
    apply div_pos
    linarith
    positivity
  linarith