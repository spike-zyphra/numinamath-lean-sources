import Mathlib

theorem number_theory_141692 : Set.Infinite {(x, y, z, t) : ℤ × ℤ × ℤ × ℤ | x^3 + y^3 = z^4 - t^2} := by
  apply Set.infinite_of_injective_forall_mem (f := λ (n : ℕ) => (2 * (n : ℤ)^4, 2 * (n : ℤ)^4, 2 * (n : ℤ)^3, (0 : ℤ)))
  · -- Show that the function is injective
    intro n m
    simp [Prod.ext_iff] at *
    <;> omega
  · -- Show that all elements generated by the function are in the set
    intro n
    simp [Prod.ext_iff]
    <;> ring_nf