import Mathlib

def isLucky (a : ℕ) := (Nat.digits 10 a).sum = 7

theorem number_theory_315997 {a : ℕ → ℕ} (ha : ∀ n, isLucky (a n)) (h : a 0 = 0)
    (h' : a 1 = 7) (h'' : a 2 = 14) (h''' : a 3 = 21) (h'''' : a 4 = 28)
    (h''''' : a 5 = 35) (h'''''' : a 6 = 42) (h''''''' : a 7 = 49) (h'''''''' : a 8 = 56)
    (h''''''''' : a 9 = 63) (h'''''''''' : a 10 = 70) (h''''''''''' : a 11 = 77)
    (h'''''''''''' : a 12 = 84) (h''''''''''''' : a 13 = 91) (h'''''''''''''' : a 14 = 98)
    (h''''''''''''''' : a 15 = 105) (h'''''''''''''''' : a 16 = 112) (h''''''''''''''''' : a 17 = 119)
    (h'''''''''''''''''' : a 18 = 126) (h''''''''''''''''''' : a 19 = 133) :
    a (5 * 19) = 52000 := by
  have h1 : isLucky (a 0) := ha 0
  rw [h] at h1 
  simp [isLucky] at h1
  all_goals omega