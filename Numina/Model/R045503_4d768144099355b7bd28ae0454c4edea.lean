import Mathlib

theorem number_theory_161079 : Set.Infinite {(x, y, z) : ℕ × ℕ × ℕ | x > 0 ∧ y > 0 ∧ z > 0 ∧ x^3 + y^5 = z^2} := by
  apply Set.infinite_of_injective_forall_mem (f := λ (t : ℕ) => (2 ^ (10 * t + 5), 2 ^ (6 * t + 3), 2 ^ (8 + 15 * t)))
  · -- Show f is injective
    intro t₁ t₂ h
    simp [Prod.ext_iff] at h
    all_goals
      omega
  · -- Show all elements generated by f are in the set
    intro t
    simp [Prod.ext_iff]
    all_goals
      ring_nf