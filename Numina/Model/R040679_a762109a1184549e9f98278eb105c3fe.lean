import Mathlib

open Real Set
open scoped Real
theorem calculus_22740 : sin (17 * π / 180) + sin (43 * π / 180) = cos (13 * π / 180) := by
  have h1 : sin (17 * π / 180) + sin (43 * π / 180) = 2 * sin (30 * π / 180) * cos (13 * π / 180) := by
    have h8 : sin (17 * π / 180) + sin (43 * π / 180) = 2 * sin ((17 * π / 180 + 43 * π / 180) / 2) * cos ((17 * π / 180 - 43 * π / 180) / 2) := by 
      have h9 : sin (17 * π / 180) + sin (43 * π / 180) = 2 * sin ((17 * π / 180 + 43 * π / 180) / 2) * cos ((17 * π / 180 - 43 * π / 180) / 2) := by
        have h10 : sin (17 * π / 180) = sin (( (17 * π / 180 + 43 * π / 180) / 2 ) + ( (17 * π / 180 - 43 * π / 180) / 2 ) ) := by 
          ring_nf 
        have h11 : sin (43 * π / 180) = sin (( (17 * π / 180 + 43 * π / 180) / 2 ) - ( (17 * π / 180 - 43 * π / 180) / 2 ) ) := by 
          ring_nf 
        rw [h10, h11] 
        have h12 : sin (( (17 * π / 180 + 43 * π / 180) / 2 ) + ( (17 * π / 180 - 43 * π / 180) / 2 ) ) = 
          sin (( (17 * π / 180 + 43 * π / 180) / 2 ) ) * cos (( (17 * π / 180 - 43 * π / 180) / 2 ) ) + cos (( (17 * π / 180 + 43 * π / 180) / 2 ) ) * sin (( (17 * π / 180 - 43 * π / 180) / 2 ) ) := by 
          rw [sin_add] 
        have h13 : sin (( (17 * π / 180 + 43 * π / 180) / 2 ) - ( (17 * π / 180 - 43 * π / 180) / 2 ) ) = 
          sin (( (17 * π / 180 + 43 * π / 180) / 2 ) ) * cos (( (17 * π / 180 - 43 * π / 180) / 2 ) ) - cos (( (17 * π / 180 + 43 * π / 180) / 2 ) ) * sin (( (17 * π / 180 - 43 * π / 180) / 2 ) ) := by 
          rw [sin_sub] 
        rw [h12, h13]
        ring 
      linarith 
    have e2 : (17 * π / 180 + 43 * π / 180) / 2 = 30 * π / 180 := by 
      linarith [pi_pos]
    have e3 : (17 * π / 180 - 43 * π / 180) / 2 = - (13 * π / 180 : ℝ) := by 
      linarith [pi_pos]
    rw [h8]
    rw [e2, e3] 
    have h51 : cos ( - (13 * π / 180 : ℝ) ) = cos (13 * π / 180 : ℝ) := by 
      have : - (13 * π / 180 : ℝ) = - ( (13 * π / 180 : ℝ) ) := by ring
      rw [this, cos_neg]
    have h51' : cos ( - (13 * π / 180 : ℝ) ) = cos (13 * π / 180 : ℝ) := h51
    simp only [h51']
    <;> ring_nf 
  rw [h1]
  have h2 : sin (30 * π / 180) = 1 / 2 := by
    have h3 : 30 * π / 180 = π / 6 := by
      ring_nf 
    rw [h3]
    rw [sin_pi_div_six]
  rw [h2]
  all_goals ring