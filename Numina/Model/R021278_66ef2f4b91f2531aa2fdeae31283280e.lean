  have h4 : (3 * ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) * α) ^3 = (162 * α^3) := by
    calc
      (3 * ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) * α) ^3 = 27 * (((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3))) ^3 * α ^3 := by ring_nf
      _ = 27 * (6: ℝ) * α ^3 := by
        rw [hab3_eq]
      _ = 162 * α ^3 := by
        norm_num
  have eq1 : α^9 - 15 * α^6 + 75 * α^3 - 125 = 162 * α^3 := by
    calc
      α^9 - 15 * α^6 + 75 * α^3 - 125 = (α^3 - 5) ^3 := by
        ring_nf
      _ = (3 * ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) * α) ^3 := by
        rw [h2]
      _ = (162 * α ^3) := by
