import Mathlib

theorem algebra_270166 {α : ℝ} (hα : α = 2 ^ ((1 : ℝ) / 3) + 3 ^ ((1 : ℝ) / 3)) :
    α^9 - 15 * α^6 - 87 * α^3 - 125 = 0 := by
  have ha3 : ((2: ℝ) ^ ((1: ℝ) / 3)) ^3 = (2: ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul]
    norm_num
    all_goals norm_num
  have hb3 : ((3: ℝ) ^ ((1: ℝ) / 3)) ^3 = (3: ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul]
    norm_num
    all_goals norm_num
  have h1 : α^3 = 5 + 3 * ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) * α := by
    rw [hα]
    have h2 : ((2: ℝ) ^ ((1: ℝ) / 3) + (3: ℝ) ^ ((1: ℝ) / 3)) ^ 3 =
        ((2: ℝ) ^ ((1: ℝ) / 3)) ^3 + ((3: ℝ) ^ ((1: ℝ) / 3)) ^3 + 3 * ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) * ((2: ℝ) ^ ((1: ℝ) / 3) + (3: ℝ) ^ ((1: ℝ) / 3)) := by
      ring
    rw [h2, ha3, hb3]
    all_goals linarith
  have hab3_eq : (((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) ) ^3 = (6 : ℝ) := by
    have h11 : ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) = (6 : ℝ) ^ ((1 : ℝ) / 3) := by
      have h12 : ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) = ((2 * 3) : ℝ) ^ ((1: ℝ) / 3) := by
        rw [← Real.mul_rpow]
        all_goals norm_num
      rw [h12]
      all_goals norm_num
    rw [h11]
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul]
    norm_num
    all_goals norm_num
  have h2 : (α^3 - 5) ^3 = (3 * ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) * α) ^3 := by
    have h_eq : α^3 - 5 = 3 * ((2: ℝ) ^ ((1: ℝ) / 3)) * ((3: ℝ) ^ ((1: ℝ) / 3)) * α := by
