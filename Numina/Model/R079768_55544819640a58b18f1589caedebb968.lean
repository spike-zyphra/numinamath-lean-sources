import Mathlib

theorem number_theory_255648 (a b : ℤ) (h : 7 ∣ a^2 + b^2) : 7 ∣ a ∧ 7 ∣ b := by
  have h1 : a % 7 = 0 ∨ a % 7 = 1 ∨ a % 7 = 2 ∨ a % 7 = 3 ∨ a % 7 = 4 ∨ a % 7 = 5 ∨ a % 7 = 6 := by 
    omega 
  have h2 : b % 7 = 0 ∨ b % 7 = 1 ∨ b % 7 = 2 ∨ b % 7 = 3 ∨ b % 7 = 4 ∨ b % 7 = 5 ∨ b % 7 = 6 := by 
    omega 
  rcases h1 with (h1 | h1 | h1 | h1 | h1 | h1 | h1) <;> rcases h2 with (h2 | h2 | h2 | h2 | h2 | h2 | h2) <;> ( 
    norm_num [Int.dvd_iff_emod_eq_zero, pow_two, Int.add_emod, Int.mul_emod, h1, h2] at h 
    <;> omega
  )