import Mathlib
open Real

theorem inequalities_9123 (α β : ℝ) (h : ∀ x y z : ℝ, α * (x * y + y * z + z * x) ≤
    √(x ^ 2 + x * y + y ^ 2) * √(y ^ 2 + y * z + z ^ 2) +
    √(y ^ 2 + y * z + z ^ 2) * √(z ^ 2 + z * x + x ^ 2) +
    √(z ^ 2 + z * x + x ^ 2) * √(x ^ 2 + x * y + y ^ 2) ∧
    √(x ^ 2 + x * y + y ^ 2) * √(y ^ 2 + y * z + z ^ 2) +
    √(y ^ 2 + y * z + z ^ 2) * √(z ^ 2 + z * x + x ^ 2) +
    √(z ^ 2 + z * x + x ^ 2) * √(x ^ 2 + x * y + y ^ 2) ≤ β * (x ^ 2 + y ^ 2 + z ^ 2)) :
    α ≤ 3 ∧ β ≥ 1 := by
  have h1 := h 1 1 1
  have h2 := h1.1
  have h3 := h1.2
  have hM : (√(1 ^ 2 + (1 : ℝ) * (1 : ℝ) + (1 : ℝ) ^ 2) * √((1 : ℝ) ^ 2 + (1 : ℝ) * (1 : ℝ) + (1 : ℝ) ^ 2) +
      √((1 : ℝ) ^ 2 + (1 : ℝ) * (1 : ℝ) + (1 : ℝ) ^ 2) * √((1 : ℝ) ^ 2 + (1 : ℝ) * (1 : ℝ) + (1 : ℝ) ^ 2) +
      √((1 : ℝ) ^ 2 + (1 : ℝ) * (1 : ℝ) + (1 : ℝ) ^ 2) * √((1 : ℝ) ^ 2 + (1 : ℝ) * (1 : ℝ) + (1 : ℝ) ^ 2) ) = 9 := by
    have h4 : √((1 : ℝ) ^ 2 + (1 : ℝ) * (1 : ℝ) + (1 : ℝ) ^ 2) = Real.sqrt 3 := by
      norm_num
    rw [h4] at *
    have h5 : Real.sqrt 3 * Real.sqrt 3 = 3 := by
      calc
        Real.sqrt 3 * Real.sqrt 3 = (Real.sqrt 3) ^ 2 := by ring
        _ = 3 := Real.sq_sqrt (by norm_num)
    nlinarith [h5]
  have h4 : α * (1 * 1 + 1 * 1 + 1 * 1) ≤
      √(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) +
      √(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) +
      √(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) := by
    simpa using h1.1
  have h5 : (√(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) +
      √(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) +
      √(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) ) = 9 := hM
  have h7 : α ≤ 3 := by
    nlinarith [h5, h4]
  have h8 : (√(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) +
      √(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) +
      √(1 ^ 2 + 1 * 1 + 1 ^ 2) * √(1 ^ 2 + 1 * 1 + 1 ^ 2) ) ≤ β * (1 ^ 2 + 1 ^ 2 + 1 ^ 2) := by
    simpa using h1.2
  have h11 : β ≥ 3 := by
    nlinarith [hM, h8]
  constructor
  · linarith [h7]
  · linarith [h11]