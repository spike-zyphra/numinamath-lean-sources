import Mathlib

theorem number_theory_235143 (M : Finset ℕ) (hM : M = (Nat.primeFactors 2310)) :
    {x | ∃ a b, a ∈ M ∧ b ∈ M ∧ x = a * b ∧ a ≠ b}.encard = 10 := by 
  have h1 : M = {2, 3, 5, 7, 11} := by
    rw [hM]
    native_decide
  have h2 : {x | ∃ a b, a ∈ M ∧ b ∈ M ∧ x = a * b ∧ a ≠ b} = 
      {6, 10, 14, 22, 15, 21, 33, 35, 55, 77} := by
    ext x
    simp only [Set.mem_setOf_eq, h1, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · -- Assume x is generated by two distinct elements.
      rintro ⟨a, b, ha, hb, he, hneq⟩
      simp at ha hb
      rcases ha with (rfl | rfl | rfl | rfl | rfl) <;> rcases hb with (rfl | rfl | rfl | rfl | rfl) <;> simp [he] at *
      <;> try { tauto }
    · -- Now assume x is in the singleton set.
      rintro (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl)
      · -- Case x = 6
        refine' ⟨2, 3, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- Case x = 10
        refine' ⟨2, 5, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- Case x = 14
        refine' ⟨2, 7, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- Case x = 22
        refine' ⟨2, 11, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- Case x = 15
        refine' ⟨3, 5, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- Case x = 21
        refine' ⟨3, 7, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- 33 = 3 * 11
        refine' ⟨3, 11, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- Case x = 35
        refine' ⟨5, 7, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- Case x = 55
        refine' ⟨5, 11, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
      · -- Case x = 77
        refine' ⟨7, 11, by simp [h1], by simp [h1], by norm_num, by norm_num⟩
  have hx : {x | ∃ a b, a ∈ M ∧ b ∈ M ∧ x = a * b ∧ a ≠ b} = {6, 10, 14, 22, 15, 21, 33, 35, 55, 77} := h2
  rw [hx]
  rw [Set.encard]
  simp [Set.ncard]
  <;> try { native_decide }