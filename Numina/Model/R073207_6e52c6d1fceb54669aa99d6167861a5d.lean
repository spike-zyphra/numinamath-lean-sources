import Mathlib

theorem algebra_21295 : (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^5| : ℝ) < (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^0| : ℝ) ∧
    (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^5| : ℝ) < (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^1| : ℝ) ∧
    (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^5| : ℝ) < (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^2| : ℝ) ∧
    (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^5| : ℝ) < (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^3| : ℝ) ∧
    (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^5| : ℝ) < (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^4| : ℝ) ∧
    (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^5| : ℝ) < (|(10^0 + 10^1 + 10^2 + 10^3 + 10^4 + 10^5) - 10^6| : ℝ) := by 
  norm_num [abs_of_nonneg]