import Mathlib

open Finset Filter Real
open scoped Topology

/- Problem Statement:
A4 (KOR) Let $a_{1}, a_{2}, \ldots, a_{n}$ be nonnegative real numbers, not all zero. (a) Prove that $x^{n}-a_{1} x^{n-1}-\cdots-a_{n-1} x-a_{n}=0$ has precisely one positive real root. (b) Let $A=\sum_{j=1}^{n} a_{j}, B=\sum_{j=1}^{n} j a_{j}$ and let $R$ be the positive real root of the equation in part (a). Prove that $$ A^{A} \leq R^{B} $$
Solution:
4. Consider the function  $$ f(x)=\frac{a_{1}}{x}+\frac{a_{2}}{x^{2}}+\cdots+\frac{a_{n}}{x^{n}} . $$  Since $f$ is strictly decreasing from $+\infty$ to 0 on the interval $(0,+\infty)$, there exists exactly one $R>0$ for which $f(R)=1$. This $R$ is also the only positive real root of the given polynomial. Since $\ln x$ is a concave function on $(0,+\infty)$, Jensen's inequality gives us  $$ \sum_{j=1}^{n} \frac{a_{j}}{A}\left(\ln \frac{A}{R^{j}}\right) \leq \ln \left(\sum_{j=1}^{n} \frac{a_{j}}{A} \cdot \frac{A}{R^{j}}\right)=\ln f(R)=0 . $$  Therefore $\sum_{j=1}^{n} a_{j}(\ln A-j \ln R) \leq 0$, which is equivalent to $A \ln A \leq$ $B \ln R$, i.e., $A^{A} \leq R^{B}$. -/

theorem algebra_24724_1
    {a : ℕ → ℝ} {n : ℕ} (a_nonneg : ∀ i ∈ Icc 1 n, 0 ≤ a i)
    (not_all_zero : ∃ i ∈ Icc 1 n, a i ≠ 0) :
    ∃! R, 0 < R ∧ R ^ n - ∑ i ∈ Icc 1 n, a i * R ^ (n - i) = 0 := by
  -- Definition of the original polynomial function `f` and the related function `g`.
  let f R := R ^ n - ∑ i ∈ Icc 1 n, a i * R ^ (n - i)
  let g R := 1 - ∑ i ∈ Icc 1 n, a i * R ^ (-i : ℤ)
  -- Show that `g` is strictly monotonic on the interval (0, +∞).
  have g_mono : StrictMonoOn g (.Ioi 0) := by
    intro x hx y hy lt
    simp only [Set.mem_Ioi] at hx hy
    simp only [g, zpow_neg, zpow_natCast, sub_lt_sub_iff_left]
    apply Finset.sum_lt_sum
    -- Prove monotonicity of the sum in `g` by analyzing individual terms.
    · -- All terms are non-negative, so it is monotone.
      intro i hi
      simp only [Finset.mem_Icc] at hi
      apply mul_le_mul_of_nonneg_left
      · rw [inv_le_inv (pow_pos hy _) (pow_pos hx _)]
        exact pow_le_pow_left (by linarith) (by linarith) _
      · exact a_nonneg _ (by simpa using hi)
    · -- There exists one `aᵢ > 0`, so it is strictly monotone.
      obtain ⟨i, hi⟩ := not_all_zero
      use i, hi.1
      apply mul_lt_mul_of_pos_left
      · rw [inv_lt_inv (pow_pos hy _) (pow_pos hx _)]
        exact pow_lt_pow_left (by linarith) (by linarith) (by simp at hi; omega)
      · have := a_nonneg i hi.1
        exact lt_of_le_of_ne this hi.2.symm
  -- Prove that the auxiliary function `g` has exactly one root.
  have exists_unique_root_R : ∃! R > 0, g R = 0 := by
    apply exists_unique_of_exists_of_unique
    · -- The existence of root can be established using intermediate value theorem.
      suffices 0 ∈ g '' Set.Ioi 0 by simpa using this
      suffices Set.Iio 1 ⊆ g '' Set.Ioi 0 by apply this; simp
      -- `𝓝[>] 0` is the filter generated by `(0, ε)`, for any `ε > 0`.
      apply IsPreconnected.intermediate_value_Iio
        (IsConnected.isPreconnected <| isConnected_Ioi) (l₁ := 𝓝[>] 0) (l₂ := atTop)
      · -- The filter `𝓝[>] 0` is less than the power set of `(0, +∞)`.
        -- This means every set `X` that contains `(0, +∞)` also contains some small interval `(0, ε)`.
        simp only [le_principal_iff]
        rw [mem_nhdsWithin_Ioi_iff_exists_Ioo_subset]
        exact ⟨1, by simp, fun a ha => by simpa using ha.1⟩
      · -- The filter `atTop` is less than the power set of `(0, +∞)`.
        -- This means every set `X` that contains `(0, +∞)` also contains some large interval `(N, +∞)`.
        simp only [le_principal_iff, mem_atTop_sets, ge_iff_le, Set.mem_Ioi]
        exact ⟨1, fun b hb => by linarith⟩
      · -- `g` is continuous. This is proven by analyzing each summand.
        apply ContinuousOn.sub continuousOn_const
        apply continuousOn_finset_sum
        rintro i -
        apply ContinuousOn.mul continuousOn_const
        apply ContinuousOn.zpow₀ continuousOn_id
        intro x hx
        simp only [Set.mem_Ioi] at hx
        exact .inl (by simp only [id_eq]; linarith)
      · -- `g(x) → -∞` when `x → 0⁺`.
        apply tendsto_atBot_of_add_const_left (C := -1)
        simp only [g, zpow_neg, zpow_natCast, add_sub, neg_add_cancel, zero_sub,
          tendsto_neg_atBot_iff, ← fun x => Finset.sum_apply x (g := fun i x => a i * (x ^ i)⁻¹)]
        -- We restrict the summation range on `a i ≠ 0`.
        rw [← Finset.sum_subset_zero_on_sdiff
          (s₁ := Icc 1 n |>.filter fun i => a i ≠ 0) (hfg := fun _ _ => rfl)]
        · -- An important trick: in `Mathlib` we only have the lemma that if `f → +∞` and `g → +∞`,
          -- we have `f + g → +∞`, but here we need the sum of finite functions. We use the lemma
          -- `Finset.sum_induction_nonempty` to perform the induction.
          apply Finset.sum_induction_nonempty
            (p := fun p => Tendsto p (𝓝[>] 0) atTop) (f := fun i x => a i * (x ^ i)⁻¹)
          · -- The induction principle: If `f → +∞` and `g → +∞`, then `f + g → +∞`.
            exact fun f g hf hg => tendsto_atTop_add hf hg
          · -- The summation range is not empty.
            simpa only [Finset.Nonempty, ne_eq, mem_filter] using not_all_zero
          · -- Every summand goes to `+∞` when `x → 0⁺`.
            simp only [mem_filter, and_imp]
            intro i hi nz
            apply Tendsto.const_mul_atTop (lt_of_le_of_ne (a_nonneg i hi) nz.symm)
            apply Tendsto.comp tendsto_inv_zero_atTop
            simp only [mem_Icc] at hi
            nth_rw 3 [show (0 : ℝ) = 0 ^ i by (have : i ≠ 0 := by omega); simp [this]]
            -- This can be proved from the fact that `f(x) = x ^ i` is continuous, and maps
            -- `(0, +∞)` to `(0, +∞)`.
            apply ContinuousWithinAt.tendsto_nhdsWithin
            · apply ContinuousWithinAt.pow
              apply continuousWithinAt_id
            · intro x hx
              simpa only [Set.mem_Ioi] using pow_pos hx _
        · simp
        · -- If `a i ≠ 0`, then the summand is zero.
          simp only [ne_eq, mem_sdiff, mem_Icc, mem_filter, not_and, Decidable.not_not, and_imp]
          intro i hi hi' hi''
          specialize hi'' hi hi'
          ext x
          simpa using .inl hi''
      · -- Prove that `g(x) → +∞` when `x → 1`.
        rw [show (1 : ℝ) = 1 - ∑ c ∈ Icc 1 n, 0 by simp]
        refine Tendsto.sub (by simp) (tendsto_finset_sum _ ?_)
        intro i hi
        -- The remaining part is easy because `Mathlib` already have lemma `tendsto_const_mul_zpow_atTop_zero`.
        apply tendsto_const_mul_zpow_atTop_zero
        simp only [mem_Icc] at hi
        omega
    · -- Uniqueness of root follows from strict monotonicity directly.
      intro x y ⟨hx, hx'⟩ ⟨hy, hy'⟩
      apply StrictMonoOn.injOn g_mono (by simpa) (by simpa)
      rwa [← hy'] at hx'
  -- Function `f` and `g` have same roots, so `f` also has exactly one root.
  have f_g_have_same_roots {R} (hR : 0 < R) : f R = 0 ↔ g R = 0 := by
    nth_rw 2 [← IsLeftRegular.mul_left_eq_zero_iff (b := R ^ n)]
    · -- `f(x) = x ^ n * g(x)`, we can prove it by tedious computation.
      suffices f R = R ^ n * g R by rw [this]
      simp only [f, g, mul_sub_left_distrib, mul_one, mul_sum, sub_right_inj]
      congr! 1 with i hi
      ring_nf
      rw [mul_assoc, ← zpow_natCast, ← zpow_natCast, ← zpow_add₀ (by linarith)]
      congr 2
      simp only [mem_Icc] at hi
      rw [Int.natCast_sub hi.2]
      ring
    · -- `R ^ n` is left regular, in the real field `ℝ`, it is equivalent to `R ^ n ≠ 0`.
      apply IsRegular.left
      apply isRegular_of_ne_zero
      apply pow_ne_zero
      linarith
  -- Combining the fact that `g` has unique root and `f` have same roots as `g`, we know that
  -- `f` also has unique root.
  convert exists_unique_root_R using 2 with R
  simpa only [gt_iff_lt, and_congr_right_iff] using f_g_have_same_roots

lemma algebra_24724_2 {a : ℕ → ℝ} {n : ℕ} {R : ℝ}
    (a_nonneg : ∀ i ∈ Icc 1 n, 0 ≤ a i) (not_all_zero : ∃ i ∈ Icc 1 n, a i ≠ 0)
    (R_pos : 0 < R) (R_is_root : R ^ n - ∑ i ∈ Icc 1 n, a i * R ^ (n - i) = 0) :
    let A := ∑ i ∈ Icc 1 n, a i
    let B := ∑ i ∈ Icc 1 n, i * a i
    A ^ A ≤ R ^ B := by
  intro A B
  -- `A` is positive, because `a i` is non-negative and not all zero.
  have A_pos : 0 < A := calc
    _ ≤ (∑ _ ∈ Icc 1 n, 0 : ℝ) := by simp
    _ < _ := by
      apply Finset.sum_lt_sum a_nonneg
      obtain ⟨i, hi, hi'⟩ := not_all_zero
      exact ⟨i, hi, lt_of_le_of_ne (a_nonneg i hi) hi'.symm⟩
  -- Definition of the original polynomial function `f` and the related function `g`.
  let f R := R ^ n - ∑ i ∈ Icc 1 n, a i * R ^ (n - i)
  let g R := 1 - ∑ i ∈ Icc 1 n, a i * R ^ (-i : ℤ)
  -- Function `f` and `g` have same roots, so `f` also has exactly one root.
  have f_g_have_same_roots {R} (hR : 0 < R) : f R = 0 ↔ g R = 0 := by
    nth_rw 2 [← IsLeftRegular.mul_left_eq_zero_iff (b := R ^ n)]
    · -- f(x) = x ^ n * g(x), we can prove it by tedious computation.
      suffices f R = R ^ n * g R by rw [this]
      simp only [f, g, mul_sub_left_distrib, mul_one, mul_sum, sub_right_inj]
      congr! 1 with i hi
      ring_nf
      rw [mul_assoc, ← zpow_natCast, ← zpow_natCast, ← zpow_add₀ (by linarith)]
      congr 2
      simp only [mem_Icc] at hi
      rw [Int.natCast_sub hi.2]
      ring
    · -- `R ^ n` is left regular, in the real field `ℝ`, it is equivalent to `R ^ n ≠ 0`.
      apply IsRegular.left
      apply isRegular_of_ne_zero
      apply pow_ne_zero
      linarith
  rw [← strictMonoOn_log.le_iff_le (rpow_pos_of_pos A_pos _) (rpow_pos_of_pos R_pos _),
    log_rpow A_pos, log_rpow R_pos]
  -- It is sufficient to prove that `(A * log A - B * log R) / A ≤ 0`.
  suffices (A * log A - B * log R) / A ≤ 0 by
    rw [div_nonpos_iff] at this
    replace this := this.resolve_left
    simp only [sub_nonneg, not_and, not_le, tsub_le_iff_right, zero_add] at this
    exact this (fun _ => A_pos) |>.1
  calc
    -- Change the summation to `∑ i = 1..n, a i * (log A - i * log R)`.
    _ = (∑ i ∈ Icc 1 n, a i * (log A - i * log R)) / A := by
      congr 1
      conv in A => simp only [A]
      simp only [B, Finset.sum_mul, ← Finset.sum_sub_distrib]
      congr! 1 with i -
      ring
    -- Change the summation to `∑ i = 1..n, (a i / A) • log (A / R ^ i)`, in preparing of the use
    -- of the Jensen's inequality.
    _ = ∑ i ∈ Icc 1 n, (a i / A) • log (A / R ^ i) := by
      rw [Finset.sum_div]
      congr! 1 with i -
      field_simp
      left
      rw [log_div (by linarith) (pow_ne_zero _ (by linarith)), log_pow]
    -- Use the Jensen inquality.
    _ ≤ log (∑ i ∈ Icc 1 n, (a i / A) • (A / R ^ i)) := by
      -- In `Mathlib`, `ConcaveOn.le_map_sum` is the Jensen's inequality.
      apply ConcaveOn.le_map_sum (s := .Ioi 0)
      · -- The concavity of logarithm function is proven in `Mathlib`.
        exact strictConcaveOn_log_Ioi.concaveOn
      · intro i hi
        apply div_nonneg (a_nonneg _ hi) (by linarith)
      · -- Summation of the weights is equal to `1`.
        rw [← Finset.sum_div]
        apply div_self
        linarith
      · rintro i -
        simpa only [Set.mem_Ioi] using div_pos A_pos (pow_pos R_pos _)
    -- The right-hand side of the Jensen's inequality can be simplified to `0`.
    -- This uses the fact that `f` and `g` have same roots.
    _ = 0 := by
      simp only [smul_eq_mul, log_eq_zero, div_mul_div_cancel₀ (show A ≠ 0 by linarith)]
      refine .inr (.inl <| Eq.symm <| eq_of_sub_eq_zero ?_)
      simp only [div_eq_mul_inv, ← zpow_neg, ← zpow_natCast]
      change g R = 0
      rwa [← f_g_have_same_roots R_pos]
