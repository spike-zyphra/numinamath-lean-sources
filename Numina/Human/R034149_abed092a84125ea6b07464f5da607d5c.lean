import Mathlib

/-- (Invariance of the subgroup generated)
    Let $(G, *)$ be a group, $S \subseteq G$ a subset of $G$, $x$ an element of $G$,
    and $s$ an element of $\langle S\rangle$.
    Show that $\langle S \cup\{x\}\rangle=\langle S \cup\{x * s\}\rangle=\langle S \cup\{s * x\}\rangle$. -/
theorem algebra_138218 {G : Type*} [Group G] (S : Set G) (x s : G)
    (hs : s ∈ Subgroup.closure S) :
    Subgroup.closure (S ∪ {x}) = Subgroup.closure (S ∪ {x * s}) ∧
    Subgroup.closure (S ∪ {x * s}) = Subgroup.closure (S ∪ {s * x}) := by
  constructor
  -- We first show $\langle S \cup\{x\}\rangle \subseteq \langle S \cup\{x * s\}\rangle$.
  · apply le_antisymm
    · rw[Subgroup.closure_le]
      -- It suffices to show $S \subseteq \langle S \cup\{x * s\}\rangle$,
      rintro y (h|rfl)
      -- which follows from $S \subseteq S \cup \{x*s\}$, and
      · apply Subgroup.subset_closure
        apply Or.inl h
      -- $x \in \langle S \cup\{x * s\}\rangle$.
      -- Since $s \in \langle S \rangle$, it is also in the subgroup generated by the larger set,
      -- hence $s^{-1}$ is too. 
      · have invs : s ⁻¹ ∈ Subgroup.closure (S ∪ {y*s}) := by
          apply Subgroup.closure_mono (h := S)
          · simp
          · simp[hs]
        -- But then, $x = (xs)s^{-1}$ must be an element of the subgroup too.
        have ys : y * s ∈ Subgroup.closure (S ∪ {y*s}) := Subgroup.subset_closure (by simp)
        convert_to y * s * s ⁻¹ ∈ _
        · group
        · apply Subgroup.mul_mem _ ys invs
    -- For the other direction, we use a similar approach - the part on $S$ is clear,
    -- and $xs \in \langle S \cup \{x\} \rangle$ since $x$ and $s$ are by construction.
    · rw[Subgroup.closure_le]
      rintro y (h|rfl)
      · apply Subgroup.subset_closure
        apply Or.inl h
      · apply Subgroup.mul_mem _
        · apply Subgroup.subset_closure (by simp)
        · apply Subgroup.closure_mono (h := S) (by simp) hs
  -- Now we show $\langle S \cup\{x * s\}\rangle\subseteq \langle S \cup\{s * x\}\rangle$.
  · apply le_antisymm
    · rw[Subgroup.closure_le]
      rintro y (h|rfl)
      -- We employ the same technique and the part about $S$ holds similarly,
      · apply Subgroup.subset_closure
        apply Or.inl h
      -- it remains to show that $xs \in \langle S \cup\{s * x\}\rangle$.
      -- We rewrite it to $s^{-1}sxs$.
      · convert_to s ⁻¹ * (s * x) * s ∈ _
        · group
        -- Then, this must be an element of the group, since $sx$ and $s$ are.
        · apply Subgroup.mul_mem
          · apply Subgroup.mul_mem
            · apply Subgroup.inv_mem
              apply Subgroup.closure_mono (h := S) (by simp) hs
            · apply Subgroup.subset_closure (by simp)
          · apply Subgroup.closure_mono (h := S) (by simp) hs
    -- The other direction works the same, except that we rewrite $sx = sxss^{-1}$, where
    -- the inner product is an element of the considered subgroup.
    · rw[Subgroup.closure_le]
      rintro y (h|rfl)
      · apply Subgroup.subset_closure
        apply Or.inl h
      · convert_to s * (x * s) * s ⁻¹ ∈ _
        · group
        · apply Subgroup.mul_mem
          · apply Subgroup.mul_mem
            · apply Subgroup.closure_mono (h := S) (by simp) hs
            · apply Subgroup.subset_closure (by simp)
          · apply Subgroup.inv_mem
            apply Subgroup.closure_mono (h := S) (by simp) hs