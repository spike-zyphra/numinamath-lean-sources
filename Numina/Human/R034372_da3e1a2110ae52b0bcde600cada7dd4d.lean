import Mathlib

open Real
open scoped BigOperators

/- The area of the parallelogram generated by the vectors $\mathbf{a}$ and $\mathbf{b}$ is 8.  Find the area of the parallelogram generated by the vectors $2 \mathbf{a} + 3 \mathbf{b}$ and $\mathbf{a} - 5 \mathbf{b}.$ -/
theorem calculus_15864 {a b : ℝ × ℝ} (ha : a ≠ 0) (hb : b ≠ 0)
  (h : abs (a.1 * b.2 - a.2 * b.1) = 8) :
  abs ((2 * a.1 + 3 * b.1) * (a.2 - 5 * b.2) - (2 * a.2 + 3 * b.2) * (a.1 - 5 * b.1)) = 104 := by
  cases' abs_cases (a.1 * b.2 - a.2 * b.1) with h₁ h₁ <;> cases' abs_cases ((2 * a.1 + 3 * b.1) * (a.2 - 5 * b.2) - (2 * a.2 + 3 * b.2) * (a.1 - 5 * b.1)) with h₂ h₂ <;> simp_all only [h₁, h₂, mul_comm] <;> linarith