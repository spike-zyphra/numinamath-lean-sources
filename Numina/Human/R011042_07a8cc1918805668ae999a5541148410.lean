import Mathlib

/- [Example 4.4.1] Given

$$

\begin{array}{l}
\frac{x^{2}}{2^{2}-1^{2}}+\frac{y^{2}}{2^{2}-3^{2}}+\frac{z^{2}}{2^{2}-5^{2}}+\frac{w^{2}}{2^{2}-7^{2}}=1, \\
\frac{x^{2}}{4^{2}-1^{2}}+\frac{y^{2}}{4^{2}-3^{2}}+\frac{z^{2}}{4^{2}-5^{2}}+\frac{w^{2}}{4^{2}-7^{2}}=1, \\
\frac{x^{2}}{6^{2}-1^{2}}+\frac{y^{2}}{6^{2}-3^{2}}+\frac{z^{2}}{6^{2}-5^{2}}+\frac{w^{2}}{6^{2}-7^{2}}=1, \\
\frac{x^{2}}{8^{2}-1^{2}}+\frac{y^{2}}{8^{2}-3^{2}}+\frac{z^{2}}{8^{2}-5^{2}}+\frac{w^{2}}{8^{2}-7^{2}}=1 .
\end{array}

$$


Find the value of $ x^{2}+y^{2}+z^{2}+w^{2} $. -/
theorem algebra_239112 (x y z w : ℝ)
    (h1 : x^2 / (2^2 - 1^2) + y^2 / (2^2 - 3^2) + z^2 / (2^2 - 5^2) + w^2 / (2^2 - 7^2) = 1)
    (h2 : x^2 / (4^2 - 1^2) + y^2 / (4^2 - 3^2) + z^2 / (4^2 - 5^2) + w^2 / (4^2 - 7^2) = 1)
    (h3 : x^2 / (6^2 - 1^2) + y^2 / (6^2 - 3^2) + z^2 / (6^2 - 5^2) + w^2 / (6^2 - 7^2) = 1)
    (h4 : x^2 / (8^2 - 1^2) + y^2 / (8^2 - 3^2) + z^2 / (8^2 - 5^2) + w^2 / (8^2 - 7^2) = 1) :
    x^2 + y^2 + z^2 + w^2 = 36
  := by
    -- normalize equations
    ring_nf at *

    -- it's a system of 4 linear equations with with 4 unknowns, so we just solve it
    linarith